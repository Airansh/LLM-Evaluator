# Copy to .env and fill in. Keys are read by the backend only and never sent to the browser.
# A provider with no key is listed by GET /models as unavailable; it is never replaced by mock output.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Exact model IDs to offer as candidates, comma-separated. Copy IDs from each provider's docs.
OPENAI_MODELS=
ANTHROPIC_MODELS=claude-haiku-4-5-20251001,claude-sonnet-5
GEMINI_MODELS=

# Judge model used for correctness/groundedness scoring (a provider from above plus an exact model ID).
JUDGE_PROVIDER=anthropic
JUDGE_MODEL=claude-sonnet-5

# Backend settings
DATABASE_URL=sqlite:///./data/evalforge.db
CORS_ORIGINS=http://localhost:3000
MAX_CONCURRENCY=4
