# EvalForge configuration. Copy this file to `.env` in the repository root:
#     cp .env.example .env
# `.env` is git-ignored. Keys are read by the backend only and are never sent to the browser.
# A model whose provider has no key is listed by GET /models as unavailable; it is never
# replaced by mock output.

# ---- API keys -------------------------------------------------------------------------------
# OpenAI:    https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Anthropic: Claude Console -> Settings -> API keys
# (EVALFORGE_ANTHROPIC_API_KEY also works, for hosts that reserve ANTHROPIC_* variables.)
ANTHROPIC_API_KEY=
# Gemini:    https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ---- Candidate models (exact model IDs, comma-separated) -----------------------------------
OPENAI_MODELS=gpt-6-luna,gpt-6-sol
ANTHROPIC_MODELS=claude-haiku-4-5,claude-sonnet-5
GEMINI_MODELS=

# ---- Judge (scores correctness and groundedness) --------------------------------------------
# Must be one of openai / anthropic / gemini, and that provider's key must be set.
JUDGE_PROVIDER=anthropic
JUDGE_MODEL=claude-sonnet-5

# ---- Sample mode ---------------------------------------------------------------------------
# Adds offline "sample/*" models and a heuristic judge, clearly labeled in the API and UI,
# so the app can be tried with no keys. Set to false to hide them.
SAMPLE_MODE=true

# ---- Backend settings ----------------------------------------------------------------------
# Under docker compose the database is always /data/evalforge.db on the named volume.
DATABASE_URL=sqlite:///./data/evalforge.db
CORS_ORIGINS=http://localhost:3000
MAX_CONCURRENCY=4
MAX_ATTEMPTS=3
REQUEST_TIMEOUT_S=120
CANDIDATE_MAX_OUTPUT_TOKENS=8192
JUDGE_MAX_OUTPUT_TOKENS=8192
# Blank = each provider's default. Some models (e.g. Claude Sonnet 5, OpenAI reasoning
# models) reject an explicit temperature, so leave this blank unless you know it's supported.
TEMPERATURE=

# ---- Frontend (docker compose build arg) -----------------------------------------------------
# URL the browser uses to reach the backend; baked into the frontend image at build time.
# NEXT_PUBLIC_API_URL=http://localhost:8000
